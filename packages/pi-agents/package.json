{
    "name": "@chlamydomonos/pi-agents",
    "version": "0.1.0",
    "description": "Multi-agent workflows for Pi: TS-defined agents + flow engine exposed as virtual models",
    "type": "module",
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "agent",
        "multi-agent",
        "workflow",
        "roleplay"
    ],
    "license": "MIT",
    "files": [
        "src",
        "dist",
        "examples",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "prepack": "node esbuild.config.mjs",
    "pi": {
        "extensions": [
            "./src/extension/index.ts"
        ]
    },
    "piWeb": {
        "plugins": [
            {
                "id": "pi-agents",
                "module": "dist/plugin/browser/index.js",
                "serverModule": "dist/plugin/server/index.js",
                "browserRoot": "dist/plugin/browser",
                "machineSpecific": true,
                "defaultEnabled": true
            }
        ]
    },
    "exports": {
        ".": "./src/extension/types.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugin.json",
        "build": "node esbuild.config.mjs",
        "build:watch": "node esbuild.config.mjs --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "smoke": "node scripts/smoke.mjs"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.1",
        "dagre": "^0.8.5",
        "jiti": "^2.7.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "typebox": "*"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "^1.1.0",
        "@earendil-works/pi-coding-agent": "^1.1.0",
        "@jmfederico/pi-web": "^1.202610.2",
        "@types/node": "^22.19.0",
        "esbuild": "^0.28.2",
        "lit": "^3.3.3",
        "typebox": "^1.3.27",
        "typescript": "^6.0.3",
        "vitest": "^3.2.4"
    }
}
